Options -Indexes
RewriteEngine On

<FilesMatch "\.(env|sql|zip|tar|gz|bak|backup|old|log|ini|yml|yaml)$">
  Require all denied
</FilesMatch>

RewriteRule ^about_us/?$ about.html [L]
RewriteRule ^services/?$ services.html [L]
RewriteRule ^gallery/?$ gallery.html [L]
RewriteRule ^kindwords/?$ kindwords.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^weddingpackage/?$ weddingpackage.html [L]
RewriteRule ^atlanta-wedding-planner/?$ atlanta-wedding-planner.html [L]
RewriteRule ^multicultural-wedding-planner-atlanta/?$ multicultural-wedding-planner-atlanta.html [L]
RewriteRule ^day-of-wedding-coordinator-atlanta/?$ day-of-wedding-coordinator-atlanta.html [L]
RewriteRule ^corporate-event-planner-atlanta/?$ corporate-event-planner-atlanta.html [L]
RewriteRule ^faq/?$ faq.html [L]

RewriteRule ^gallery/([0-9]+)/?$ gallery/$1/index.html [L]
